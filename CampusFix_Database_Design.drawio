          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="DESIGN RULES&lt;br/&gt;1. Roles: REPORTER, STAFF, ADMIN. Each user has exactly one role.&lt;br/&gt;2. A category belongs to one department; complaint department is derived through category.&lt;br/&gt;3. Assignment rows preserve reassignment history. At most one open assignment per complaint.&lt;br/&gt;4. Feedback is optional, at most one row per complaint; author is the complaint reporter.&lt;br/&gt;5. Status history is append-only. Creation records old_status = NULL.&lt;br/&gt;6. Embeddings are optional until indexing completes; one whole-complaint vector per complaint.&lt;br/&gt;7. Role checks, valid status transitions, feedback eligibility and history creation require backend logic / triggers." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="1370" width="1835" height="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
