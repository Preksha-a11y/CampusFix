# CampusFix Environment Configuration Example
# Copy this file to .env and insert your real database credentials

# PostgreSQL with pgvector (e.g. Supabase, Neon, or Local PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# MongoDB NoSQL Document Store (Local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/campusfix_nosql
